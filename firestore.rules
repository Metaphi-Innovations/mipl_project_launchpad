rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /launchpadApplications/{document} {
      allow read, write: if request.auth != null;
    }

    match /launchpadUsers/{document} {
      allow read, write: if request.auth != null;
    }

    match /launchpadJobDescriptions/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
