rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /launchpadApplications/{document} {
      allow read, write: if request.auth != null;
    }

    match /launchpadUsers/{document} {
      allow read, write: if request.auth != null;
    }

    match /launchpadJobDescriptions/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /launchpadPasswordResetRequests/{document} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['email', 'status', 'requestedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
